# Makefile para Módulo 5: Técnicas Avanzadas

NVCC = nvcc
NVCC_FLAGS = -O3 -arch=sm_50 -Xcompiler -Wall

# Este módulo contendrá ejemplos avanzados
# Por ahora solo README
EJEMPLOS =

.PHONY: all clean help

all:
	@echo "Módulo 5: Técnicas Avanzadas"
	@echo "Este módulo contiene documentación sobre técnicas avanzadas."
	@echo "Los ejemplos se pueden agregar según necesidad."

clean:
	@rm -f $(EJEMPLOS)
	@echo "✓ Módulo 5 limpio"

help:
	@echo "Módulo 5: Técnicas Avanzadas"
	@echo ""
	@echo "Este módulo cubre:"
	@echo "  - Operaciones a nivel de warp"
	@echo "  - Dynamic parallelism"
	@echo "  - Multi-GPU programming"
	@echo "  - Bibliotecas CUDA (Thrust, CUB, cuBLAS)"
